# Optional override for the Guard App backend base URL.
# Do not include /api/v1 because the app adds it automatically.
#
# Physical phone on the same Wi-Fi:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:5000
#
# Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000

EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:5000

# --- Crash/error reporting (Sentry) ---------------------------------------
# Everything below is optional. Leaving EXPO_PUBLIC_SENTRY_DSN empty fully
# disables Sentry (initSentry() becomes a no-op) — safe default for local
# dev. See docs/crash-reporting.md for setup + how to verify it end-to-end.

# Client-safe DSN, baked into the app bundle at build time. Get it from
# Sentry -> Project Settings -> Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=

# development | staging | production. Defaults to "development" under
# `expo start` and "production" otherwise.
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=production

# Fraction (0.0-1.0) of error events sent. Defaults to 1 (every error) —
# lower this if a noisy device starts eating into your Sentry quota.
# EXPO_PUBLIC_SENTRY_SAMPLE_RATE=1

# Fraction (0.0-1.0) of performance traces sent. Defaults to 0 (off) — this
# ticket is about error visibility, not perf monitoring.
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Set to "true" to let a local `expo start` dev build also report crashes.
# Off by default so developer machines don't spam the project.
# EXPO_PUBLIC_SENTRY_ENABLE_IN_DEV=false

# --- Build-time only: DO NOT put these in EXPO_PUBLIC_* / do not commit ---
# Used by the Sentry Expo/Metro plugin to upload source maps during
# `expo export` / EAS builds so stack traces in the dashboard are readable.
# Set these as EAS/CI secrets, never in a committed .env file.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
