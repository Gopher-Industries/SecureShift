# Test environment configuration
# Copy this file to .env.test and fill in your local test database URI
# DO NOT commit .env.test to the repository

NODE_ENV=test

# Local test database URI (must use secureshift_test database)
MONGO_TEST_URI=mongodb://secureshift_app:secureshift_app_password@localhost:27017/secureshift_test?authSource=secureshift_local
MONGO_URI=mongodb://secureshift_app:secureshift_app_password@localhost:27017/secureshift_local?authSource=secureshift_local

JWT_SECRET=test-jwt-secret-do-not-use-in-production
LICENCE_ENC_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=