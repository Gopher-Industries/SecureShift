# Optional local Docker Compose host-port overrides.
# Most users do not need to copy this file.
#
# If a default host port is already occupied, copy this file to .env and
# uncomment the relevant value. For example, use BACKEND_HOST_PORT=5001 when
# port 5000 is occupied. On macOS, AirPlay Receiver can sometimes use port 5000.

# BACKEND_HOST_PORT=5001
# FRONTEND_HOST_PORT=3002
# ADMIN_FRONTEND_HOST_PORT=3003
# MONGODB_HOST_PORT=27018

# Defaults: backend 5000, employer 3000, admin 3001, MongoDB 27017.
# Mailpit SMTP/UI default to 1025/8025 and remain loopback-bound.
# MAILPIT_SMTP_HOST_PORT=1026
# MAILPIT_UI_HOST_PORT=8026
# These are host-port overrides only; no private credentials are needed.
# Compose Ollama has no published host port. See README.md for AI readiness.
